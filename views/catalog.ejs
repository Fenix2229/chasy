<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= currentCategory ? currentCategory.description || currentCategory.name : 'Каталог часов Командирские, Амфибия, Восток' %>">
    <title><%= title %> | <%= siteName %></title>
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/pages.css">
</head>
<body>
    <%- include('partials/header', { categories, cartCount: typeof cartCount !== 'undefined' ? cartCount : 0 }) %>

    <main>
        <!-- Breadcrumbs -->
        <nav class="breadcrumbs">
            <div class="container">
                <ul class="breadcrumbs-list">
                    <li class="breadcrumbs-item"><a href="/">Главная</a></li>
                    <li class="breadcrumbs-item"><a href="/catalog">Каталог</a></li>
                    <% if (currentCategory) { %>
                        <li class="breadcrumbs-item active"><%= currentCategory.name %></li>
                    <% } %>
                </ul>
            </div>
        </nav>

        <!-- Page Header -->
        <section class="page-header">
            <div class="container">
                <h1 class="page-title"><%= currentCategory ? currentCategory.name : 'Каталог часов' %></h1>
                <% if (currentCategory && currentCategory.description) { %>
                    <p class="page-description"><%= currentCategory.description %></p>
                <% } %>
                <div class="products-count">
                    Найдено товаров: <strong><%= totalProducts %></strong>
                </div>
            </div>
        </section>

        <!-- Catalog Content -->
        <section class="catalog-section section">
            <div class="container">
                <div class="catalog-layout">
                    <!-- Sidebar with categories -->
                    <aside class="catalog-sidebar">
                        <div class="sidebar-block">
                            <h3 class="sidebar-title">Коллекции</h3>
                            <ul class="categories-menu">
                                <li class="category-menu-item <%= !currentCategory ? 'active' : '' %>">
                                    <a href="/catalog">
                                        <span class="category-name">Все часы</span>
                                    </a>
                                </li>
                                <% categories.forEach(function(cat) { %>
                                    <li class="category-menu-item <%= currentCategory && currentCategory.slug === cat.slug ? 'active' : '' %>">
                                        <a href="/catalog/category/<%= cat.slug %>">
                                            <span class="category-name"><%= cat.name %></span>
                                            <span class="category-count">(<%= cat.product_count || 0 %>)</span>
                                        </a>
                                    </li>
                                <% }); %>
                            </ul>
                        </div>

                        <!-- Price filter placeholder -->
                        <div class="sidebar-block">
                            <h3 class="sidebar-title">Цена</h3>
                            <div class="price-filter">
                                <div class="price-inputs">
                                    <input type="number" placeholder="от" class="price-min" id="price-min">
                                    <span>—</span>
                                    <input type="number" placeholder="до" class="price-max" id="price-max">
                                </div>
                                <button class="btn btn-sm btn-outline" onclick="applyPriceFilter()">Применить</button>
                            </div>
                        </div>

                        <!-- Stock filter -->
                        <div class="sidebar-block">
                            <h3 class="sidebar-title">Наличие</h3>
                            <label class="checkbox-label">
                                <input type="checkbox" id="in-stock-only" onchange="filterByStock(this.checked)">
                                <span>Только в наличии</span>
                            </label>
                        </div>
                    </aside>

                    <!-- Products Grid -->
                    <div class="catalog-content">
                        <!-- Sort -->
                        <div class="catalog-toolbar">
                            <div class="sort-options">
                                <label>Сортировка:</label>
                                <select id="sort-select" onchange="applySorting(this.value)">
                                    <option value="default">По умолчанию</option>
                                    <option value="price-asc">Цена: по возрастанию</option>
                                    <option value="price-desc">Цена: по убыванию</option>
                                    <option value="name-asc">По названию (А-Я)</option>
                                </select>
                            </div>
                            <div class="view-options">
                                <button class="view-btn active" data-view="grid" title="Сетка">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="3" width="7" height="7"></rect>
                                        <rect x="14" y="3" width="7" height="7"></rect>
                                        <rect x="3" y="14" width="7" height="7"></rect>
                                        <rect x="14" y="14" width="7" height="7"></rect>
                                    </svg>
                                </button>
                                <button class="view-btn" data-view="list" title="Список">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="3" y1="6" x2="21" y2="6"></line>
                                        <line x1="3" y1="12" x2="21" y2="12"></line>
                                        <line x1="3" y1="18" x2="21" y2="18"></line>
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <!-- Products -->
                        <div class="products-grid" id="products-grid">
                            <% if (products && products.length > 0) { %>
                                <% products.forEach(function(product) { %>
                                    <div class="product-card" data-product-id="<%= product.id %>" data-price="<%= product.price %>" data-stock="<%= product.stock %>">
                                        <a href="/catalog/product/<%= product.slug %>" class="product-image">
                                            <img src="<%= product.image || '/images/no-image.svg' %>" alt="<%= product.name %>" onerror="this.src='/images/no-image.svg'">
                                            <% if (product.old_price) { %>
                                                <span class="product-badge badge-sale">-<%= Math.round((1 - product.price/product.old_price) * 100) %>%</span>
                                            <% } %>
                                            <div class="product-overlay">
                                                <a href="/catalog/product/<%= product.slug %>" class="overlay-btn btn-view">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                        <circle cx="12" cy="12" r="3"></circle>
                                                    </svg>
                                                    Просмотреть
                                                </a>
                                                <button class="overlay-btn btn-buy" onclick="event.preventDefault(); addToCart(<%= product.id %>)" <%= product.stock <= 0 ? 'disabled' : '' %>>
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <circle cx="9" cy="21" r="1"></circle>
                                                        <circle cx="20" cy="21" r="1"></circle>
                                                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                                    </svg>
                                                    Купить
                                                </button>
                                            </div>
                                        </a>
                                        <div class="product-info">
                                            <div class="product-category"><%= product.category_name || 'Часы' %></div>
                                            <h3 class="product-title">
                                                <a href="/catalog/product/<%= product.slug %>"><%= product.name %></a>
                                            </h3>
                                            <div class="product-price">
                                                <span class="price-current"><%= product.price.toLocaleString('ru-RU') %> ₽</span>
                                                <% if (product.old_price) { %>
                                                    <span class="price-old"><%= product.old_price.toLocaleString('ru-RU') %> ₽</span>
                                                <% } %>
                                            </div>
                                            <div class="product-stock <%= product.stock > 0 ? 'in-stock' : 'out-of-stock' %>">
                                                <span class="stock-indicator"></span>
                                                <%= product.stock > 0 ? 'В наличии (' + product.stock + ' шт.)' : 'Нет в наличии' %>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <div class="no-products">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <circle cx="11" cy="11" r="8"></circle>
                                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                    </svg>
                                    <p>Товары не найдены</p>
                                    <a href="/catalog" class="btn btn-outline">Показать все товары</a>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

    <script src="/js/main.js"></script>
    <script>
        // Client-side filtering
        function applyPriceFilter() {
            const min = parseInt(document.getElementById('price-min').value) || 0;
            const max = parseInt(document.getElementById('price-max').value) || Infinity;
            
            document.querySelectorAll('.product-card').forEach(card => {
                const price = parseInt(card.dataset.price);
                const visible = price >= min && price <= max;
                card.style.display = visible ? '' : 'none';
            });
        }
        
        function filterByStock(inStockOnly) {
            document.querySelectorAll('.product-card').forEach(card => {
                const stock = parseInt(card.dataset.stock);
                const visible = !inStockOnly || stock > 0;
                card.style.display = visible ? '' : 'none';
            });
        }
        
        function applySorting(sortType) {
            const grid = document.getElementById('products-grid');
            const cards = Array.from(grid.querySelectorAll('.product-card'));
            
            cards.sort((a, b) => {
                if (sortType === 'price-asc') {
                    return parseInt(a.dataset.price) - parseInt(b.dataset.price);
                } else if (sortType === 'price-desc') {
                    return parseInt(b.dataset.price) - parseInt(a.dataset.price);
                } else if (sortType === 'name-asc') {
                    return a.querySelector('.product-title').textContent.localeCompare(
                        b.querySelector('.product-title').textContent, 'ru'
                    );
                }
                return 0;
            });
            
            cards.forEach(card => grid.appendChild(card));
        }
        
        // View toggle (grid/list)
        document.querySelectorAll('.view-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.view-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                const grid = document.getElementById('products-grid');
                grid.classList.toggle('list-view', this.dataset.view === 'list');
            });
        });
    </script>
</body>
</html>
