<!-- Шапка сайта komandirskie.su -->
<header class="header">
    <!-- Верхняя полоса -->
    <div class="header-top">
        <div class="container">
            <div class="header-top-content">
                <div class="header-contacts">
                    <a href="tel:+78001234567" class="header-phone">
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                        </svg>
                        8 (800) 123-45-67
                    </a>
                    <span class="header-work-hours">Пн-Пт: 9:00 - 18:00</span>
                </div>
                <div class="header-links">
                    <a href="/delivery">Доставка и оплата</a>
                    <a href="/about">О компании</a>
                    <a href="/contacts">Контакты</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Основная шапка -->
    <div class="header-main">
        <div class="container">
            <div class="header-main-content">
                <!-- Логотип -->
                <a href="/" class="logo">
                    <div class="logo-icon">
                        <svg viewBox="0 0 50 50" fill="none">
                            <circle cx="25" cy="25" r="23" stroke="currentColor" stroke-width="2"/>
                            <circle cx="25" cy="25" r="18" stroke="currentColor" stroke-width="1"/>
                            <line x1="25" y1="25" x2="25" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <line x1="25" y1="25" x2="35" y2="25" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <circle cx="25" cy="25" r="2" fill="currentColor"/>
                        </svg>
                    </div>
                    <div class="logo-text">
                        <span class="logo-name">КОМАНДИРСКИЕ</span>
                        <span class="logo-tagline">Легендарные российские часы</span>
                    </div>
                </a>

                <!-- Поиск -->
                <div class="header-search">
                    <form action="/search" method="GET" class="search-form">
                        <input type="text" name="q" placeholder="Поиск часов..." class="search-input" autocomplete="off">
                        <button type="submit" class="search-btn">
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"/>
                                <path d="m21 21-4.35-4.35"/>
                            </svg>
                        </button>
                    </form>
                </div>

                <!-- Корзина -->
                <div class="header-actions">
                    <a href="/cart" class="cart-btn">
                        <div class="cart-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="9" cy="21" r="1"/>
                                <circle cx="20" cy="21" r="1"/>
                                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                            </svg>
                            <span class="cart-count" id="cart-count"><%= typeof cartCount !== 'undefined' ? cartCount : 0 %></span>
                        </div>
                        <div class="cart-info">
                            <span class="cart-label">Корзина</span>
                            <span class="cart-total" id="cart-total"><%= typeof cartTotal !== 'undefined' ? cartTotal.toLocaleString('ru-RU') : 0 %> ₽</span>
                        </div>
                    </a>
                </div>

                <!-- Мобильное меню -->
                <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Меню">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
    </div>

    <!-- Навигация -->
    <nav class="nav" id="main-nav">
        <div class="container">
            <ul class="nav-list">
                <li class="nav-item">
                    <a href="/catalog" class="nav-link">Все часы</a>
                </li>
                <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                    <% categories.forEach(function(cat) { %>
                        <li class="nav-item">
                            <a href="/catalog/category/<%= cat.slug %>" class="nav-link <%= (typeof currentCategory !== 'undefined' && currentCategory && currentCategory.slug === cat.slug) ? 'active' : '' %>">
                                <%= cat.name %>
                            </a>
                        </li>
                    <% }); %>
                <% } %>
            </ul>
        </div>
    </nav>
</header>
