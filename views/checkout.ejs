<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Оформление заказа - <%= siteName %>">
    <title><%= title %> | <%= siteName %></title>
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/pages.css">
</head>
<body>
    <%- include('partials/header', { categories, cartCount: cartItems.length }) %>

    <main>
        <!-- Breadcrumbs -->
        <nav class="breadcrumbs">
            <div class="container">
                <ul class="breadcrumbs-list">
                    <li class="breadcrumbs-item"><a href="/">Главная</a></li>
                    <li class="breadcrumbs-item"><a href="/cart">Корзина</a></li>
                    <li class="breadcrumbs-item active">Оформление заказа</li>
                </ul>
            </div>
        </nav>

        <!-- Checkout Page -->
        <section class="checkout-page section">
            <div class="container">
                <h1 class="page-title">Оформление заказа</h1>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-error">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <%= error %>
                    </div>
                <% } %>

                <form action="/cart/checkout" method="POST" class="checkout-form" id="checkout-form">
                    <div class="checkout-layout">
                        <div class="checkout-main">
                            <!-- Contact Info -->
                            <div class="checkout-section">
                                <h2 class="checkout-section-title">
                                    <span class="section-number">1</span>
                                    Контактные данные
                                </h2>
                                <div class="form-grid">
                                    <div class="form-group">
                                        <label for="name">Имя и Фамилия <span class="required">*</span></label>
                                        <input type="text" id="name" name="name" required placeholder="Иван Иванов">
                                    </div>
                                    <div class="form-group">
                                        <label for="phone">Телефон <span class="required">*</span></label>
                                        <input type="tel" id="phone" name="phone" required placeholder="+7 (999) 123-45-67">
                                    </div>
                                    <div class="form-group full-width">
                                        <label for="email">Email <span class="required">*</span></label>
                                        <input type="email" id="email" name="email" required placeholder="example@mail.ru">
                                    </div>
                                </div>
                            </div>

                            <!-- Delivery -->
                            <div class="checkout-section">
                                <h2 class="checkout-section-title">
                                    <span class="section-number">2</span>
                                    Доставка
                                </h2>
                                <div class="delivery-options">
                                    <label class="delivery-option">
                                        <input type="radio" name="delivery" value="cdek" checked>
                                        <div class="option-content">
                                            <div class="option-icon">🚚</div>
                                            <div class="option-info">
                                                <div class="option-title">СДЭК</div>
                                                <div class="option-desc">2-7 дней, от 350 ₽</div>
                                            </div>
                                        </div>
                                    </label>
                                    <label class="delivery-option">
                                        <input type="radio" name="delivery" value="post">
                                        <div class="option-content">
                                            <div class="option-icon">📮</div>
                                            <div class="option-info">
                                                <div class="option-title">Почта России</div>
                                                <div class="option-desc">5-14 дней, от 290 ₽</div>
                                            </div>
                                        </div>
                                    </label>
                                    <label class="delivery-option">
                                        <input type="radio" name="delivery" value="courier">
                                        <div class="option-content">
                                            <div class="option-icon">🏃</div>
                                            <div class="option-info">
                                                <div class="option-title">Курьер</div>
                                                <div class="option-desc">1-3 дня, от 450 ₽</div>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                                <div class="form-group full-width" style="margin-top: 20px;">
                                    <label for="address">Адрес доставки <span class="required">*</span></label>
                                    <textarea id="address" name="address" required rows="3" placeholder="Город, улица, дом, квартира, индекс"></textarea>
                                </div>
                            </div>

                            <!-- Payment -->
                            <div class="checkout-section">
                                <h2 class="checkout-section-title">
                                    <span class="section-number">3</span>
                                    Оплата
                                </h2>
                                <div class="payment-options">
                                    <label class="payment-option">
                                        <input type="radio" name="payment" value="card" checked>
                                        <div class="option-content">
                                            <div class="option-icon">💳</div>
                                            <div class="option-info">
                                                <div class="option-title">Банковская карта</div>
                                                <div class="option-desc">Visa, Mastercard, Мир</div>
                                            </div>
                                        </div>
                                    </label>
                                    <label class="payment-option">
                                        <input type="radio" name="payment" value="sbp">
                                        <div class="option-content">
                                            <div class="option-icon">🏦</div>
                                            <div class="option-info">
                                                <div class="option-title">СБП</div>
                                                <div class="option-desc">Система быстрых платежей</div>
                                            </div>
                                        </div>
                                    </label>
                                    <label class="payment-option">
                                        <input type="radio" name="payment" value="cash">
                                        <div class="option-content">
                                            <div class="option-icon">💵</div>
                                            <div class="option-info">
                                                <div class="option-title">При получении</div>
                                                <div class="option-desc">Наличными или картой курьеру</div>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <!-- Notes -->
                            <div class="checkout-section">
                                <h2 class="checkout-section-title">
                                    <span class="section-number">4</span>
                                    Комментарий к заказу
                                </h2>
                                <div class="form-group">
                                    <textarea id="notes" name="notes" rows="3" placeholder="Пожелания к заказу, удобное время доставки и т.д."></textarea>
                                </div>
                            </div>
                        </div>

                        <!-- Order Summary -->
                        <div class="checkout-sidebar">
                            <div class="order-summary">
                                <h3 class="summary-title">Ваш заказ</h3>
                                
                                <div class="order-items">
                                    <% cartItems.forEach(function(item) { %>
                                        <div class="order-item">
                                            <img src="<%= item.product.image || '/images/no-image.svg' %>" alt="<%= item.product.name %>" class="order-item-image">
                                            <div class="order-item-info">
                                                <div class="order-item-name"><%= item.product.name %></div>
                                                <div class="order-item-meta">
                                                    <%= item.quantity %> × <%= item.price.toLocaleString('ru-RU') %> ₽
                                                </div>
                                            </div>
                                            <div class="order-item-subtotal">
                                                <%= item.subtotal.toLocaleString('ru-RU') %> ₽
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>

                                <div class="summary-divider"></div>

                                <div class="summary-row">
                                    <span>Товары (<%= cartItems.reduce((sum, item) => sum + item.quantity, 0) %>):</span>
                                    <span><%= cartTotal.toLocaleString('ru-RU') %> ₽</span>
                                </div>
                                <div class="summary-row">
                                    <span>Доставка:</span>
                                    <span class="delivery-note">рассчитывается</span>
                                </div>

                                <div class="summary-divider"></div>

                                <div class="summary-row summary-total">
                                    <span>Итого:</span>
                                    <span><%= cartTotal.toLocaleString('ru-RU') %> ₽</span>
                                </div>

                                <button type="submit" class="btn btn-primary btn-lg btn-submit">
                                    Подтвердить заказ
                                </button>

                                <p class="checkout-agreement">
                                    Нажимая кнопку, вы соглашаетесь с 
                                    <a href="#">условиями обработки персональных данных</a>
                                </p>
                            </div>

                            <a href="/cart" class="back-to-cart">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="19" y1="12" x2="5" y2="12"></line>
                                    <polyline points="12 19 5 12 12 5"></polyline>
                                </svg>
                                Вернуться в корзину
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

    <script src="/js/main.js"></script>
    <script>
        // Form validation
        document.getElementById('checkout-form').addEventListener('submit', function(e) {
            const name = document.getElementById('name').value.trim();
            const phone = document.getElementById('phone').value.trim();
            const email = document.getElementById('email').value.trim();
            const address = document.getElementById('address').value.trim();
            
            if (!name || !phone || !email || !address) {
                e.preventDefault();
                showNotification('Пожалуйста, заполните все обязательные поля', 'error');
                return false;
            }
            
            // Simple phone validation
            if (!/^[\d\s\+\-\(\)]{10,}$/.test(phone)) {
                e.preventDefault();
                showNotification('Пожалуйста, введите корректный номер телефона', 'error');
                return false;
            }
            
            // Simple email validation
            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                e.preventDefault();
                showNotification('Пожалуйста, введите корректный email', 'error');
                return false;
            }
        });

        // Phone mask (simple)
        document.getElementById('phone').addEventListener('input', function(e) {
            let value = e.target.value.replace(/\D/g, '');
            if (value.length > 0 && value[0] !== '7' && value[0] !== '8') {
                value = '7' + value;
            }
            if (value.length > 11) {
                value = value.substring(0, 11);
            }
            
            let formatted = '';
            if (value.length > 0) {
                formatted = '+7';
                if (value.length > 1) {
                    formatted += ' (' + value.substring(1, 4);
                }
                if (value.length > 4) {
                    formatted += ') ' + value.substring(4, 7);
                }
                if (value.length > 7) {
                    formatted += '-' + value.substring(7, 9);
                }
                if (value.length > 9) {
                    formatted += '-' + value.substring(9, 11);
                }
            }
            e.target.value = formatted;
        });
    </script>
</body>
</html>
