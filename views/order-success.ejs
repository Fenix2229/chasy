<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Заказ успешно оформлен - <%= siteName %>">
    <title><%= title %> | <%= siteName %></title>
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/pages.css">
</head>
<body>
    <%- include('partials/header', { categories, cartCount: 0 }) %>

    <main>
        <!-- Success Page -->
        <section class="order-success-page section">
            <div class="container">
                <div class="success-content">
                    <div class="success-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="16 10 11 15 8 12"></polyline>
                        </svg>
                    </div>
                    
                    <h1 class="success-title">Спасибо за заказ!</h1>
                    <p class="success-text">
                        Ваш заказ <strong>#<%= order.order_number %></strong> успешно оформлен.<br>
                        Мы отправили подтверждение на <strong><%= order.customer_email %></strong>
                    </p>

                    <div class="order-details-card">
                        <h3>Детали заказа</h3>
                        
                        <div class="order-info-grid">
                            <div class="order-info-item">
                                <span class="info-label">Номер заказа:</span>
                                <span class="info-value">#<%= order.order_number %></span>
                            </div>
                            <div class="order-info-item">
                                <span class="info-label">Дата:</span>
                                <span class="info-value"><%= new Date(order.created_at).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
                            </div>
                            <div class="order-info-item">
                                <span class="info-label">Статус:</span>
                                <span class="info-value status-badge status-new">Новый</span>
                            </div>
                            <div class="order-info-item">
                                <span class="info-label">Сумма:</span>
                                <span class="info-value price"><%= order.total.toLocaleString('ru-RU') %> ₽</span>
                            </div>
                        </div>

                        <div class="order-items-summary">
                            <h4>Товары в заказе:</h4>
                            <% if (order.items && order.items.length > 0) { %>
                                <ul class="order-items-list">
                                    <% order.items.forEach(function(item) { %>
                                        <li>
                                            <span class="item-name"><%= item.name %></span>
                                            <span class="item-qty"><%= item.quantity %> шт.</span>
                                            <span class="item-price"><%= item.subtotal.toLocaleString('ru-RU') %> ₽</span>
                                        </li>
                                    <% }); %>
                                </ul>
                            <% } %>
                        </div>

                        <div class="order-customer-info">
                            <h4>Данные получателя:</h4>
                            <p><strong><%= order.customer_name %></strong></p>
                            <p><%= order.customer_phone %></p>
                            <p><%= order.customer_email %></p>
                            <p><%= order.customer_address %></p>
                        </div>
                    </div>

                    <div class="success-next-steps">
                        <h3>Что дальше?</h3>
                        <div class="steps-grid">
                            <div class="step">
                                <div class="step-icon">📧</div>
                                <div class="step-text">
                                    <strong>Подтверждение</strong>
                                    <p>Мы отправили письмо с деталями заказа</p>
                                </div>
                            </div>
                            <div class="step">
                                <div class="step-icon">📞</div>
                                <div class="step-text">
                                    <strong>Обработка</strong>
                                    <p>Менеджер свяжется с вами для подтверждения</p>
                                </div>
                            </div>
                            <div class="step">
                                <div class="step-icon">📦</div>
                                <div class="step-text">
                                    <strong>Доставка</strong>
                                    <p>После оплаты отправим заказ</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="success-actions">
                        <a href="/" class="btn btn-primary">На главную</a>
                        <a href="/catalog" class="btn btn-outline">Продолжить покупки</a>
                    </div>

                    <div class="success-contact">
                        <p>Есть вопросы? Свяжитесь с нами:</p>
                        <a href="tel:+78001234567" class="contact-phone">8 (800) 123-45-67</a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

    <script src="/js/main.js"></script>
</body>
</html>
